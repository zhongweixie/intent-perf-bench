{
  "schema_version": 4,
  "effective_date": "2026-10-04",
  "scope": "each_arm_of_future_newly_registered_experiments",
  "max_wall_time_s": 900,
  "max_total_tokens": null,
  "max_api_calls": 48,
  "token_accounting": {
    "limit_measure": "cumulative_output_tokens_per_arm_including_reasoning",
    "cumulative_input_plus_output_limit": null,
    "cumulative_input_limit": null,
    "cumulative_output_limit": 60000,
    "track_cumulative_input_output_usage": true,
    "cached_input_included_in_usage_but_not_output_budget": true,
    "reasoning_output_included": true,
    "avoid_double_counting_usage_subfields": true,
    "unknown_usage": "retain_full_conservative_output_reservation_until_reconciled; do_not_reset_or_assume_zero",
    "pre_request_output_reservation_required": true,
    "stop_on_cumulative_output_tokens": true,
    "stop_on_cumulative_input_plus_output_usage": false,
    "per_request_output_cap": "at_or_below_remaining_cumulative_output_budget_and_model_context_limit",
    "pre_request_context_validation_required": true
  },
  "api_accounting": {
    "measure": "actual_model_request_attempts_per_arm",
    "failed_requests_included": true,
    "retries_included": true,
    "hidden_sdk_retries_allowed": false
  },
  "wall_time_origin": "first_model_request",
  "stop_policy": "earliest_wall_time_cumulative_output_or_api_limit_then_stop_writes_and_seal_fixed_candidate",
  "preserve_frozen_and_in_progress_experiments": true,
  "execution_authorization": false,
  "max_output_tokens_per_request": null,
  "max_cumulative_output_tokens": 60000,
  "controller_migration": {
    "requires_explicit_support_for_schema_version": 4,
    "disable_cumulative_input_plus_output_admission_and_stop": true,
    "enforce_cumulative_output_admission_and_stop": true,
    "validate_requested_output_tokens_at_or_below_remaining_output_budget": true,
    "verify_actual_api_payload_output_limit": true,
    "retain_output_reservation_for_unknown_usage": true,
    "verify_large_input_total_does_not_consume_output_budget": true,
    "verify_cumulative_output_60000_stops_and_dynamic_output_shrinks": true,
    "verify_reasoning_accounting_without_double_counting": true,
    "verify_api_48_accept_49_reject_and_wall_time_stop_seal": true,
    "do_not_silently_use_legacy_controller": true,
    "disable_arm_pair_and_batch_monetary_limits": true,
    "disable_fee_estimation_and_reservation_admission_gates": true,
    "keep_fee_ledger_reporting_only": true,
    "verify_high_or_unknown_fee_does_not_reject_or_stop": true,
    "verify_only_wall_time_cumulative_output_or_api_usage_ends_budget": true
  },
  "monetary_budget": {
    "enabled": false,
    "max_cost_usd_per_arm": null,
    "max_cost_usd_per_pair": null,
    "max_cost_usd_per_batch": null,
    "request_admission_uses_cost": false,
    "fee_reservation_required_for_admission": false,
    "stop_on_cost": false,
    "track_actual_and_estimated_cost_for_reporting": true,
    "track_unknown_cost_for_reporting": true,
    "unknown_cost_blocks_requests": false
  },
  "session_spend_cap_usd": null,
  "batch_spend_cap_usd": null,
  "total_cap_usd": null
}
