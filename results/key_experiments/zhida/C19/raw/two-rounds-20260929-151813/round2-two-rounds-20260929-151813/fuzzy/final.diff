+def _fast_softmax_topk(
+    gating_output: torch.Tensor,
+    topk: int,
+    renormalize: bool,
+    routed_scaling_factor: float,
+):
+    # num_expert_group <= 1 makes the group mask all-ones, so the grouped
+    # selection degenerates to a plain global top-k over the softmax scores.
+    # top-k of softmax(x) followed by renormalization is exactly
+    # softmax(top-k logits), which avoids materializing the full softmax.
+    vals, idx = torch.topk(gating_output, k=topk, dim=-1, sorted=False)
+    if renormalize:
+        weights = torch.softmax(vals, dim=-1)
+    else:
+        weights = torch.softmax(gating_output, dim=-1).gather(1, idx)
+    if routed_scaling_factor != 1.0:
+        weights = weights * routed_scaling_factor
+    return weights.to(torch.float32), idx.to(torch.int32)
+
