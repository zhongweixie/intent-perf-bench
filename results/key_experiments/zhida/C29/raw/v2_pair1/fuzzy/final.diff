+class _CombineFn(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, src, scores, ti, top_k):
+        N, H = src.shape
+        T = N // top_k
+        if src.stride(1) != 1:
+            src = src.contiguous()
+        scores = scores.contiguous() if scores.stride(1) != 1 else scores
+        ti = ti.contiguous()
+        with torch.no_grad():
+            inv = torch.empty(N, dtype=torch.int32, device=src.device)
+            inv[ti.long()] = torch.arange(N, dtype=torch.int32, device=src.device)
+        ti32 = ti.to(torch.int32) if ti.dtype != torch.int32 else ti
+        out = src.new_empty((T, H))
+        if T > 0:
+            _combine_fwd_kernel[(T,)](
+                src, inv, scores, out,
+                src.stride(0), scores.stride(0), out.stride(0),
+                K=top_k, H=H, BLOCK_H=min(1024, triton.next_power_of_2(H)), num_warps=4)
+        ctx.save_for_backward(src, scores, ti32, inv)
+        ctx.top_k = top_k
+        return out
+
+    @staticmethod
+    def backward(ctx, grad_out):
+        src, scores, ti32, inv = ctx.saved_tensors
+        top_k = ctx.top_k
+        N, H = src.shape
+        T = N // top_k
+        gsrc = torch.empty_like(src)
+        gs32 = torch.zeros(scores.shape, dtype=torch.float32, device=src.device)
+        if T > 0:
+            g = grad_out.reshape(T, H)
+            if g.stride(1) != 1:
+                g = g.contiguous()
+            _combine_bwd_kernel[(T,)](
+                src, g, inv, ti32, scores, gsrc, gs32,
+                src.stride(0), g.stride(0), gsrc.stride(0), scores.stride(0),
+                K=top_k, H=H, BLOCK_H=min(512, triton.next_power_of_2(H)), num_warps=4)
+        return gsrc, gs32.to(scores.dtype), None, None
