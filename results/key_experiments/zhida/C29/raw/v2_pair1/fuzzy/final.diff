+if _TRITON_AVAILABLE:
+
+    @triton.jit
+    def _gather_zero_pad_kernel(src_ptr, idx_ptr, out_ptr,
+                                s_stride, o_stride,
+                                H: tl.constexpr, BLOCK_H: tl.constexpr):
+        # out[row] = (idx[row] >= 0) ? src[idx[row]] : 0
+        row = tl.program_id(0).to(tl.int64)
+        idx = tl.load(idx_ptr + row)
+        valid = idx >= 0
+        safe = tl.maximum(idx, 0).to(tl.int64)
+        offs = tl.arange(0, BLOCK_H)
+        for h0 in range(0, H, BLOCK_H):
+            cols = h0 + offs
+            m = cols < H
+            vals = tl.load(src_ptr + safe * s_stride + cols, mask=m & valid, other=0.0)
+            tl.store(out_ptr + row * o_stride + cols, vals, mask=m)
+
+    @triton.jit
+    def _scatter_skip_neg_kernel(src_ptr, idx_ptr, out_ptr,
+                                 s_stride, o_stride,
+                                 H: tl.constexpr, BLOCK_H: tl.constexpr):
+        # out[idx[row]] = src[row] for idx[row] >= 0 (each target written once)
+        row = tl.program_id(0).to(tl.int64)
+        idx = tl.load(idx_ptr + row)
+        if idx >= 0:
+            dst = idx.to(tl.int64)
+            offs = tl.arange(0, BLOCK_H)
+            for h0 in range(0, H, BLOCK_H):
+                cols = h0 + offs
+                m = cols < H
+                vals = tl.load(src_ptr + row * s_stride + cols, mask=m, other=0.0)
+                tl.store(out_ptr + dst * o_stride + cols, vals, mask=m)
+
+    @triton.jit
+    def _combine_fwd_kernel(src_ptr, inv_ptr, scores_ptr, out_ptr,
+                            s_stride, sc_stride, o_stride,
+                            K: tl.constexpr, H: tl.constexpr, BLOCK_H: tl.constexpr):
+        t = tl.program_id(0).to(tl.int64)
+        offs = tl.arange(0, BLOCK_H)
+        for h0 in range(0, H, BLOCK_H):
+            cols = h0 + offs
+            m = cols < H
+            acc = tl.zeros([BLOCK_H], dtype=tl.float32)
+            for k in tl.static_range(K):
+                i = tl.load(inv_ptr + t * K + k).to(tl.int64)
+                s = tl.load(scores_ptr + t * sc_stride + k).to(tl.float32)
+                v = tl.load(src_ptr + i * s_stride + cols, mask=m, other=0.0).to(tl.float32)
+                acc += s * v
+            tl.store(out_ptr + t * o_stride + cols, acc.to(out_ptr.dtype.element_ty), mask=m)
+
+    @triton.jit
+    def _combine_bwd_kernel(src_ptr, g_ptr, inv_ptr, ti_ptr, scores_ptr,
+                            gsrc_ptr, gs_ptr,
+                            s_stride, g_stride, gs_stride, sc_stride,
+                            K: tl.constexpr, H: tl.constexpr, BLOCK_H: tl.constexpr):
+        t = tl.program_id(0).to(tl.int64)
+        offs = tl.arange(0, BLOCK_H)
+        for h0 in range(0, H, BLOCK_H):
+            cols = h0 + offs
+            m = cols < H
+            g = tl.load(g_ptr + t * g_stride + cols, mask=m, other=0.0).to(tl.float32)
+            for k in tl.static_range(K):
+                i32 = tl.load(inv_ptr + t * K + k)
+                i = i32.to(tl.int64)
+                s = tl.load(scores_ptr + t * sc_stride + k).to(tl.float32)
+                v = tl.load(src_ptr + i * s_stride + cols, mask=m, other=0.0).to(tl.float32)
+                tl.store(gsrc_ptr + i * gs_stride + cols,
+                         (g * s).to(gsrc_ptr.dtype.element_ty), mask=m)
+                dot = tl.sum(g * v)
+                pos = tl.load(ti_ptr + i)
+                tl.atomic_add(gs_ptr + pos, dot)
+
 
