{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntentPerfBench Task Ground Truth",
  "type": "object",
  "required": [
    "task_id", "level", "source", "primary_workload", "primary_metric",
    "threshold", "threshold_source", "primary_targets",
    "acceptable_targets", "misdiagnosed_targets",
    "visible_evidence", "required_investigation_steps"
  ],
  "properties": {
    "task_id":          { "type": "string", "pattern": "^ipb_[a-z0-9_]+$" },
    "level": {
      "type": "string",
      "enum": ["L1", "L2", "L3"],
      "description": "L1=隐藏目标, L2=隐藏性能合同, L3=错误用户诊断"
    },
    "source": {
      "type": "object",
      "required": ["benchmark", "instance_id", "provenance"],
      "properties": {
        "benchmark":   { "type": "string", "enum": ["swefficiency", "gso", "injected", "fresh", "private"] },
        "instance_id": { "type": "string" },
        "provenance":  { "type": "string", "enum": ["legacy", "injected", "fresh", "private"] }
      }
    },
    "primary_workload":  { "type": "string" },
    "primary_metric":    { "type": "string", "enum": ["end-to-end-runtime", "throughput", "latency-p95"] },
    "threshold":         { "type": "number", "exclusiveMinimum": 1.0 },
    "threshold_source":  { "type": "string", "description": "可见文件路径（e.g. .github/workflows/performance.yml）" },
    "primary_targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "symbols"],
        "properties": {
          "file":    { "type": "string" },
          "symbols": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "acceptable_targets": {
      "type": "array",
      "items": { "$ref": "#/properties/primary_targets/items" },
      "description": "正确但非预期的优化目标（达到同等加速的替代方案）"
    },
    "misdiagnosed_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept", "files"],
        "properties": {
          "concept": { "type": "string" },
          "files":   { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "visible_evidence": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string" },
          "role": {
            "type": "string",
            "enum": [
              "end-to-end-reproducer", "profiler-target",
              "benchmark-evidence", "acceptance-threshold",
              "correctness-contract", "distractor"
            ]
          }
        }
      }
    },
    "required_investigation_steps": {
      "type": "array",
      "items": { "type": "string", "enum": [
        "run_reproducer", "profile_workload", "read_benchmark",
        "read_threshold_source", "read_correctness_contract",
        "disprove_misdiagnosis"
      ]},
      "description": "完成任务必须执行的调查步骤（用于轨迹评测）"
    },
    "misdiagnosis_counterfactual": {
      "type": "object",
      "required": ["component_share", "maximum_possible_speedup", "can_meet_threshold"],
      "properties": {
        "component_share":           { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum_possible_speedup":  { "type": "number", "exclusiveMinimum": 1.0 },
        "can_meet_threshold":        { "type": "boolean", "description": "必须为 false（否则无效的 L3 任务）" }
      }
    }
  }
}
