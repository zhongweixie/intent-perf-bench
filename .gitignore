# Isolated per-run workspaces created by scripts/ipb_workspace.py
.scratch/
__pycache__/
*.pyc

# Test results (exclude historical runs, keep summary and key experiments)
results/*_run*.json
results/*.json

# Keep summary and key experiment data
!results/summary/
!results/key_experiments/
.tmp_workspaces/
.tmp/

# Workspace directories (contain test runs and git repos)

# Environment
.env
ipb_py310_env/

# Logs
*.log
slurm_outputs/
seed/*.jsonl

# Rebuildable test data (see workspace/REBUILD_DATA.md)
tasks/ipb_dev_030/workspace/test_events.json
tasks/ipb_dev_033/workspace/test_records.json
tasks/ipb_dev_001/workspace/workspace/

# Reference repositories (large, clone via SETUP.sh)
seed/reference_repos/

# Container images (distributed via Docker Hub)
containers/*.sif
ipb_workspaces_v1.0.tar.gz
