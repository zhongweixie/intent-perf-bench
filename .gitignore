# Isolated per-run workspaces created by scripts/ipb_workspace.py
.scratch/
__pycache__/
*.pyc

# Test results (exclude historical runs, keep summary and key experiments)
results/*_run*.json
results/*.json

# Keep summary and key experiment data
!results/summary/
!results/key_experiments/
.tmp_workspaces/
.tmp/

# Workspace directories (contain test runs and git repos)
tasks/*/workspace/

# Environment
.env
ipb_py310_env/

# Logs
*.log
slurm_outputs/
